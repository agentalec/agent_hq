{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hq.dev/schemas/event.schema.json",
  "title": "Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "kind", "ticket_id", "run_id"],
  "properties": {
    "event_id": { "type": "string" },
    "kind": { "type": "string" },
    "ticket_id": { "type": "string" },
    "run_id": { "type": "string" },
    "task_id": { "type": "string" },
    "task_version": { "type": "integer", "minimum": 1 },
    "state": {
      "type": "string",
      "enum": ["QUEUED", "RUNNING", "WAITING_GATE", "SUCCEEDED", "FAILED", "BLOCKED"]
    },
    "duration_seconds": { "type": "number", "minimum": 0 },
    "tokens": { "type": ["integer", "null"] },
    "cost_usd": { "type": ["number", "null"] },
    "bindings": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "run_url": { "type": "string" },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "detail": { "type": "string" }
  }
}
