{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hq.dev/schemas/projects.schema.json",
  "title": "Projects config",
  "type": "object",
  "additionalProperties": false,
  "required": ["repos", "intake_label", "engine_repo"],
  "properties": {
    "repos": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "intake_label": { "type": "string" },
    "engine_repo": {
      "type": "string",
      "description": "org/repo hosting the engine's own issue tracker (intake, pinned comments, escalations) -- distinct from the work repos in repos.yml"
    }
  }
}
