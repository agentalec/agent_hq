{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hq.dev/schemas/projects.schema.json",
  "title": "Projects config",
  "type": "object",
  "additionalProperties": false,
  "required": ["repos", "intake_label"],
  "properties": {
    "repos": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "intake_label": { "type": "string" }
  }
}
