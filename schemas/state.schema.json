{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hq.dev/schemas/state.schema.json",
  "title": "Per-ticket state document",
  "type": "object",
  "additionalProperties": false,
  "required": ["ticket_id", "status", "runs"],
  "properties": {
    "ticket_id": { "type": "string" },
    "pinned_comment_id": { "type": ["string", "integer", "null"] },
    "status": { "type": "string", "enum": ["ACTIVE", "AWAITING_MERGE", "BLOCKED", "DONE"] },
    "block_reason": { "type": ["string", "null"] },
    "block_source": { "type": ["string", "null"] },
    "interrupted_run_id": { "type": ["string", "null"] },
    "work_repos": {
      "type": "array",
      "items": { "$ref": "#/$defs/work_repo" }
    },
    "runs": {
      "type": "array",
      "items": { "$ref": "#/$defs/run" }
    }
  },
  "$defs": {
    "work_repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo"],
      "properties": {
        "repo": { "type": "string" },
        "branch": { "type": ["string", "null"] },
        "pr_ref": { "type": ["string", "null"] },
        "recorded_head": { "type": ["string", "null"] },
        "base_branch": { "type": ["string", "null"] },
        "comments_polled_at": {
          "type": ["string", "null"],
          "description": "Watermark for the sweep's PR-comment poll: only comments created at or after this are considered. A watermark, not the dedupe -- comment ids are deduped through the event log."
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "target_task", "reason"],
      "properties": {
        "key": { "type": "string" },
        "target_task": { "type": "string" },
        "reason": { "type": "string" },
        "repo": { "type": ["string", "null"] },
        "artifacts": { "type": "array", "items": { "type": "string" } },
        "source_run_id": { "type": ["string", "null"] }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "task_id",
        "task_version",
        "ticket_id",
        "state",
        "attempt",
        "bindings",
        "cost_usd",
        "tokens",
        "usage_known",
        "artifacts",
        "chain_depth"
      ],
      "properties": {
        "run_id": { "type": "string" },
        "task_id": { "type": "string" },
        "task_version": { "type": "integer", "minimum": 1 },
        "ticket_id": { "type": "string" },
        "state": {
          "type": "string",
          "enum": ["QUEUED", "RUNNING", "WAITING_GATE", "SUCCEEDED", "FAILED", "BLOCKED"]
        },
        "deadline": { "type": ["string", "null"] },
        "attempt_started_at": { "type": ["string", "null"] },
        "gate_requested_at": { "type": ["string", "null"] },
        "gate_request_id": { "type": ["string", "integer", "null"] },
        "base_commit": { "type": ["string", "null"] },
        "output_commit": { "type": ["string", "null"] },
        "pr_ref": { "type": ["string", "null"] },
        "attempt": { "type": "integer", "minimum": 0 },
        "parent_run_id": { "type": ["string", "null"] },
        "source_event_id": { "type": ["string", "null"] },
        "enqueue_index": { "type": ["integer", "null"] },
        "queue_seq": {
          "type": "integer",
          "minimum": 0,
          "description": "This run's position in the ticket's queue. Dispatch orders QUEUED runs by it, so queue position is stored rather than inferred from array order. Absent on runs written before it existed: readers fall back to the run's array index, which is exactly the order dispatch used then. A retry inherits the position of the attempt it replaces, so it resumes where that attempt sat rather than moving behind everything queued after it."
        },
        "handoff_key": { "type": ["string", "null"] },
        "repo": { "type": ["string", "null"] },
        "input_artifacts": { "type": "array", "items": { "type": "string" } },
        "pending_handoffs": {
          "type": "array",
          "items": { "$ref": "#/$defs/handoff" }
        },
        "bindings": {
          "type": "object",
          "description": "Port name -> concrete adapter used for this run",
          "additionalProperties": { "type": "string" }
        },
        "cost_usd": { "type": ["number", "null"] },
        "tokens": { "type": ["integer", "null"] },
        "usage_known": { "type": "boolean" },
        "artifacts": { "type": "array", "items": { "type": "string" } },
        "chain_depth": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
